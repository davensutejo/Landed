# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible provider works. Option A: GLM (Zhipu BigModel, China endpoint).
LLM_API_KEY=your-key
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4.5-air
LLM_TIMEOUT=60
# Option B (what the eval used): OpenRouter + DeepSeek, with a free model as fallback when it is rate-limited or down.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=deepseek/deepseek-v4.1-flash
# LLM_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl:free
# (z-ai/glm-5.3-flash needs LLM_THINKING=enabled and is far too slow for chat.)
# glm-4.5-air with thinking disabled: ~2-8 s per turn and passed the reliability bench.
# On OpenRouter this is sent as reasoning.enabled=false. Models without reasoning ignore it.
LLM_THINKING=disabled
